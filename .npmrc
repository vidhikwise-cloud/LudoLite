# Install devDependencies even when NODE_ENV=production.
#
# Render sets NODE_ENV=production for Node services, and npm honours that by
# installing only `dependencies` -- 125 of this repo's 746 packages. Every
# tool that builds this repo (typescript, vite, tsx) is a devDependency, so
# the build then fails several ways at once:
#
#   "This is not the tsc command you are looking for"
#   error TS2688: Cannot find type definition file for 'vite/client'
#   sh: 1: tsx: not found
#
# The first of those is the misleading one: with typescript absent, `npx tsc`
# does not fail. npx fetches an unrelated package named `tsc` from the
# registry and runs it.
#
# This file is read by npm itself from the repo root, so it applies to every
# install regardless of how the build command is invoked or whether a CLI
# flag survives -- which a `--include=dev` flag in a build command does not
# always do.
#
# Build-time only: the deployed service still runs on the production
# dependency tree, because the build output is what gets served.
production=false
