# Release signing credentials.
#
# Copy to keystore.properties (no .example) and fill in. That file is
# gitignored and must never be committed.
#
# Create the key once:
#
#   keytool -genkey -v -keystore ludo-upload.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias ludo-upload
#
# Back up ludo-upload.jks somewhere safe. If you lose it you cannot publish
# an update to your own app without Google's key-reset process.

storeFile=../../../ludo-upload.jks
storePassword=CHANGE_ME
keyAlias=ludo-upload
keyPassword=CHANGE_ME
