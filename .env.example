# ---------------------------------------------------------------------------
# Ludo With Friends — server configuration
# Copy to apps/server/.env and edit. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
#
# Leave EMPTY in production: the server serves the web client itself, so
# everything is same-origin and no cross-origin request should be accepted.
#
# Two cases need entries here:
#   * development, where the Vite dev server is a different origin
#   * the Android app, which loads from https://localhost in its webview
#     and therefore calls the API cross-origin. Add https://localhost when
#     you ship the Android build.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Postgres. For local dev you can run:
#   docker run -d --name ludo-pg -e POSTGRES_PASSWORD=ludo -e POSTGRES_DB=ludo -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:ludo@localhost:5432/ludo?schema=public

# Signing secret for player session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-in-every-environment


# ---------------------------------------------------------------------------
# PAID HOSTING — DISABLED BY DEFAULT. DO NOT ENABLE WITHOUT EVIDENCE.
# ---------------------------------------------------------------------------
#
# Setting this to true is NOT sufficient to collect money. The server
# additionally requires two approval records in the database (see
# docs/COMPLIANCE.md and `npm run approvals:status`). All three must be
# satisfied, or room activation returns 402 PAID_HOSTING_UNAVAILABLE.
#
# Flipping this flag without the written legal opinion and the written
# payment-provider confirmation on file will not enable payments. That is
# deliberate: a single misconfigured env var must not be able to start
# charging real people.
#
PAID_ROOM_HOSTING_ENABLED=false

# Hosting fee charged to the room creator only, in paise. 100 paise = Rs 1.
# Invited players are never charged. This is a hosting/access fee, not a
# stake, entry pool, or prize contribution.
HOSTING_FEE_PAISE=100
CURRENCY=INR

# Payment provider adapter to use.
#   none    - no provider wired up (default; paid hosting cannot run)
#   mock    - in-process fake provider for automated tests
#   sandbox - provider test/sandbox credentials, clearly labelled in the UI
#
# There is intentionally no production provider adapter registered yet.
# See docs/COMPLIANCE.md for why, and what must be true before one is added.
PAYMENT_PROVIDER=none

# Sandbox credentials only. Never place live keys in this file.
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Refund window: a host may cancel for a full refund until the first move.
REFUND_WINDOW_MINUTES=60
