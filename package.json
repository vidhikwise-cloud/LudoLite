{
  "name": "ludolite",
  "private": true,
  "version": "0.1.0",
  "description": "Ludo With Friends — play Ludo with friends, Rs 1 per hosted match, zero paid ads.",
  "workspaces": [
    "packages/engine",
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "db:generate": "npm run db:generate --workspace apps/server",
    "db:migrate": "npm run db:migrate --workspace apps/server",
    "android:sync": "npm run android:sync --workspace apps/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
